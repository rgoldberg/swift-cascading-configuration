#!/bin/zsh -f
#
# Scripts/clean
# swift-cascading-configuration
#
# Copyright © 2026 Ross Goldberg
# SPDX-License-Identifier: MIT
#
# Deletes the build folder & other generated files.
#
# Usage: clean [-D] [-P] [-r] [-x]
#
# -D: keep dependencies, via swift package clean instead of swift package reset
#
# -P: keep the build folder & dependencies
#
# -r: also delete Package.resolved
#
# -x: also delete .swiftpm & .index-build
#

. "${0:A:h}/_setup-script"

print_notice '🗑​ Cleaning' "${@}"

zmodload zsh/zutil
zparseopts -D -F -A received_flag D P r x
readonly -A received_flag

if ! [[ -v 'received_flag[-P]' ]]; then
	swift package "${${received_flag[-D]+clean}:-reset}"
fi
if [[ -v 'received_flag[-r]' && -e Package.resolved ]]; then
	trash Package.resolved
fi
if [[ -v 'received_flag[-x]' ]]; then
	# shellcheck disable=SC1036
	readonly -a generated_folders=(.swiftpm(N/) .index-build(N/))
	if (("${#generated_folders}")); then
		trash "${generated_folders[@]}"
	fi
fi
