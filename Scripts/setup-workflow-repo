#!/bin/zsh -f
#
# Scripts/setup-workflow-repo
# swift-cascading-configuration
#
# Copyright © 2026 Ross Goldberg
# SPDX-License-Identifier: MIT
#
# Sets up the repo for use in a GitHub workflow.
#

. "${0:A:h}/_setup-script"

# shellcheck disable=SC2066
for branch in\
	"${(f)"$(git for-each-ref refs/remotes/origin --format='%(if)%(symref)%(then)%(else)%(refname:strip=3)%(end)')":#}"
do
	git branch --track "${branch}" "origin/${branch}" >/dev/null 2>&1 || true
done
