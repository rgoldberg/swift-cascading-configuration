#!/bin/zsh -f
#
# Scripts/api-breakage
# swift-cascading-configuration
#
# Copyright © 2026 Ross Goldberg
# SPDX-License-Identifier: MIT
#
# Diagnoses each change to the public API that breaks source compatibility with the baseline treeish ${1} (by default,
# the latest version tag that HEAD contains), passing ${@:2} to swift package diagnose-api-breaking-changes.
#

. "${0:A:h}/_setup-script"

print_notice '💔 Diagnosing API breakage for' "${@}"

baseline="${1:-"$(git describe --tags --abbrev=0 --match '[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)"}"
readonly baseline
if [[ -z "${baseline}" ]]; then
	print_error 'No version tag for comparison'
fi

swift package diagnose-api-breaking-changes "${baseline}" "${@:2}"
