#!/bin/zsh -f
#
# Scripts/check
# swift-cascading-configuration
#
# Copyright © 2026 Ross Goldberg
# SPDX-License-Identifier: MIT
#
# Runs each check named in ${@} (by default, every check), in the order of ${all_checks}, except each check named by a
# -S option (e.g., -S api-breakage), continuing after a failed check, then reports each failed check. Passes the flags
# of Scripts/lint (e.g., -A) to Scripts/lint.
#

. "${0:A:h}/_setup-script"

print_notice '✅ Checking' "${@}"

zmodload zsh/zutil
zparseopts -D -F -a lint_flags A L V S+:=skip_options
readonly -a lint_flags skip_options

readonly -a all_checks=(lint build test docs api-breakage)
# shellcheck disable=SC2034
readonly -a skipped_checks=(${${skip_options:#-S}#-S})
readonly -a selected_checks=("${@:-${all_checks[@]}}")

# shellcheck disable=SC2206
readonly -a unknown_checks=(${(u)selected_checks:|all_checks} ${(u)skipped_checks:|all_checks})
if (("${#unknown_checks}")); then
	print_error 'Unknown checks: %s' "${(j:, :)unknown_checks}"
fi

typeset -a failed_checks=()
for check in ${${all_checks:*selected_checks}:|skipped_checks}; do
	# Passes the flags of Scripts/lint only to Scripts/lint
	"Scripts/${check}" ${${(M)check:#lint}:+${lint_flags[@]}} || failed_checks+=("${check}")
done

if (("${#failed_checks}")); then
	print_error 'Failed checks: %s%s%s'\
		"${(j:, :)failed_checks[1,-2]}"\
		"${failed_checks[2]+ & }"\
		"${failed_checks[-1]}"
fi
