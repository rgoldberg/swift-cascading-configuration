#!/bin/zsh -f
#
# Scripts/release-start
# swift-cascading-configuration
#
# Copyright © 2026 Ross Goldberg
# SPDX-License-Identifier: MIT
#
# Starts the release process by triggering workflow dispatch to create a GitHub draft release.
#
# Usage: release-start <version> <title> [<ref>]
#
# <version> must match the following regular expression:
#
# ^(0|[1-9][[:digit:]]*)\.(0|[1-9][[:digit:]]*)\.(0|[1-9][[:digit:]]*)(-(alpha|beta|rc)\.(0|[1-9][[:digit:]]*))?$
#
# <title> may contain at most 64 characters, which cannot be control characters
#
# <ref>, if supplied, must be on the main branch; defaults to the tip of the GitHub main branch
#

. "${0:A:h}/_setup-script"

readonly version="${1}"
readonly title="${2}"

export SCC_VERSION="${version}"
print_notice '🚀 Starting release for' "${@}"
unset SCC_VERSION
printf $'\n'

readonly number='(0|[1-9][[:digit:]]*)'
if [[ ! "${version}" =~ "^${number}\.${number}\.${number}(-(alpha|beta|rc)\.${number})?$" ]]; then
	print_error '%s is not a valid version' "${version}"
fi

if (("${#title}" > 64)); then
	print_error $'Title \'%s\' contains more than 64 characters' "${(q)title}" || exit 2
fi

if [[ "${title}" =~ [[:cntrl:]] ]]; then
	print_error $'Title \'%s\' contains control characters' "${(q)title}" || exit 3
fi

# shellcheck disable=SC1027,SC1036,SC1072,SC1073
if [[ "${title}" = (' '*|*' ') ]]; then
	print_error $'Title \'%s\' begins or ends with a space' "${(q)title}" || exit 4
fi

read -r gh_repo_url default_branch default_branch_sha < <(
	gh repo view --json url,defaultBranchRef -q '.url + " " + .defaultBranchRef.name + " " + .defaultBranchRef.target.oid'
)
readonly gh_repo_url default_branch default_branch_sha

readonly ref="${3:-"${default_branch_sha}"}"
git fetch -q "${gh_repo_url}.git" "${default_branch}"
commit_sha="$(git rev-parse --verify "${ref}^{commit}")"
readonly commit_sha
if ! git merge-base --is-ancestor "${commit_sha}" "${default_branch_sha}"; then
	print_error '%s is not on the %s branch of %s' "${ref}" "${default_branch}" "${gh_repo_url}" || exit 5
fi

gh workflow run release-start.yaml -f version="${version}" -f title="${title}" -f ref="${commit_sha}"
