#!/bin/zsh -f
#
# Scripts/lint
# swift-cascading-configuration
#
# Copyright © 2026 Ross Goldberg
# SPDX-License-Identifier: MIT
#
# Reports style violations without making any modifications to the code.
#
# Usage: lint [-A] [-L] [-V]
#
# -A: skip SwiftLint Analyze, which needs xcodebuild
#
# -L: skip Layout linting
#
# -V: skip Vale prose linting
#
# Please keep in sync with Scripts/format.
#

. "${0:A:h}/_setup-script"
unsetopt err_exit

print_notice '🚨 Linting' "${@}"

zmodload zsh/zutil
zparseopts -D -F -A received_flag A L V
readonly -A received_flag

# shellcheck disable=SC2086
ensure_command_available\
	actionlint\
	editorconfig-checker\
	git\
	markdownlint-cli2\
	shellcheck\
	swiftformat\
	swiftlint\
	${received_flag[-V]-vale}\
	yamllint\
	zizmor ||
	exit

readonly -a files=("${(@0)"$(project_files)"}")
readonly -a swift_files=("${(@M)files:#*.swift}")
readonly -a markdown_files=("${(@M)files:#*.md}")
readonly -a script_files=("${(@M)files:#Scripts/*}")

integer exit_status=0

print_section '🕊​ SwiftFormat'
# Lints with SwiftFormat, passing ${@} to it
lint_swiftformat() {
	swiftformat --lint --color always "${@}" |& filter_swiftformat_output\
		'\(lint mode - no files will be changed\.\)'\
		'0/[0-9]+ files require formatting\.'\
		$'\e\\[31mSource input did not pass lint check\\.\e\\[0m'
}
if ((${#swift_files})); then
	lint_swiftformat "${swift_files[@]}"
	((exit_status |= ${?}))
fi
# Indent Swift code in Markdown by 4 spaces, because .editorconfig indents Markdown with spaces
if ((${#markdown_files})); then
	lint_swiftformat --indent 4 "${markdown_files[@]}"
	((exit_status |= ${?}))
fi

print_section '🦅 SwiftLint'
swiftlint --strict --quiet --reporter relative-path -- "${swift_files[@]}"
((exit_status |= ${?}))

if ! [[ -v 'received_flag[-A]' ]]; then
	print_section '🔬 SwiftLint Analyze'
	# Builds the library & tests into a new folder, so that the log holds the compiler invocation of each file
	derived_data_folder="$(mktemp -d)"
	readonly derived_data_folder
	readonly xcodebuild_log="${derived_data_folder}/xcodebuild.log"
	# shellcheck disable=SC2154
	if xcodebuild build-for-testing\
		-scheme swift-cascading-configuration\
		-destination "platform=macOS,arch=${CPUTYPE},variant=macos"\
		-derivedDataPath "${derived_data_folder}"\
		>"${xcodebuild_log}" 2>&1
	then
		# Passes absolute paths, because SwiftLint matches no relative path with a compiler invocation in the log, so it
		# would analyze no file
		swiftlint analyze --strict --quiet --reporter relative-path --compiler-log-path "${xcodebuild_log}"\
			-- "${swift_files[@]:A}"
		((exit_status |= ${?}))
	else
		print -r -- "$(<"${xcodebuild_log}")"
		print_error 'xcodebuild failed'
		((exit_status |= 1))
	fi
	trash "${derived_data_folder}"
fi

if ! [[ -v 'received_flag[-L]' ]]; then
	print_section '📏 Layout'
	Scripts/layout
	((exit_status |= ${?}))
fi

print_section '〽️ Markdown'
markdownlint-cli2 -- "${markdown_files[@]/#/:}"
((exit_status |= ${?}))

if ! [[ -v 'received_flag[-V]' ]]; then
	print_section '📖 Vale'
	vale --output=line -- "${markdown_files[@]}" "${swift_files[@]}" "${(@M)files:#*.y(a|)ml}"
	((exit_status |= ${?}))
fi

print_section '📝 YAML'
yamllint -s -- "${(@M)files:#(*.yaml|*.yml|(*/|).yamllint)}"
((exit_status |= ${?}))

print_section '🌳 Git'
# Checks every tracked file (not only unstaged changes) by comparing it with the empty tree
git diff --check "$(git hash-object -t tree /dev/null)"
((exit_status |= ${?}))

print_section '💤 Zsh'
for script in "${script_files[@]}"; do
	/bin/zsh -fn "${script}"
	((exit_status |= ${?}))
done

print_section '📜 Script Conventions'
# Reports each violation of .claude/rules/scripting.md that no other linter detects
# shellcheck disable=SC2016
readonly setup_line='. "${0:A:h}/_setup-script"'
for script in "${script_files[@]}"; do
	# shellcheck disable=SC2034
	script_lines=("${(@f)"$(<"${script}")"}")
	if [[ "${script_lines[1]}" != '#!/bin/zsh -f' ]]; then
		print_error '%s does not start with #!/bin/zsh -f' "${script}"
		((exit_status |= 1))
	fi
	if [[ "${script}" != Scripts/_setup-script ]] && ! ((${script_lines[(Ie)${setup_line}]})); then
		print_error '%s does not source Scripts/_setup-script' "${script}"
		((exit_status |= 1))
	fi
done
# Each rm instead of trash, each cp without -c & each error printed in red instead of via print_error
if git grep -nP '(^\s*|[;|&(]\s*)(rm|cp(?!\s+-c\b))\s|\\e\[1;9?1m' --\
	Scripts .github/workflows ':!Scripts/_setup-script'
then
	print_error 'Use trash instead of rm, cp -c instead of cp & print_error instead of printing an error in red'
	((exit_status |= 1))
fi

print_section '🏷 File Headers'
# Each script & config file starts with a header that names the file, then the project, each on its own comment line
# shellcheck disable=SC1036,SC2034,SC2206
readonly -aU header_files=(
	${(M)files:#(.github|.vale|Scripts)/*}
	${(M)files:#(*.y(a|)ml|.editorconfig|.gitattributes|.gitignore|.swiftformat|.vale.ini|Brewfile)}
)
for file in "${header_files[@]}"; do
	# shellcheck disable=SC2034
	file_lines=("${(@f)"$(<"${file}")"}")
	if [[ $'\n'"${(F)file_lines[1,8]}"$'\n' != *$'\n#\n# '"${file}"$'\n# swift-cascading-configuration\n'* ]]; then
		print_error '%s does not start with a header that names the file & the project' "${file}"
		((exit_status |= 1))
	fi
done
# GitHub Actions evaluates each if condition as an expression, so only one that starts with !, which YAML reads as a
# tag, needs ${{…}}
if git grep -nE '^[[:space:]]*if: \$\{\{[^!]' -- .github/workflows; then
	# shellcheck disable=SC2016
	print_error 'Omit ${{…}} from each if condition that does not start with !'
	((exit_status |= 1))
fi

print_section '🕊​ SwiftFormat Options'
# SwiftFormat reads an option without a value as an empty value (e.g., --wrap-closure-bodies as no function at all)
if grep -nE '^--[a-z-]+[[:space:]]*$' .swiftformat; then
	print_error 'Give each SwiftFormat option in .swiftformat a value'
	((exit_status |= 1))
fi

print_section '🐙 ActionLint'
actionlint -shellcheck shellcheck -- "${(@M)files:#.github/workflows/[^/]##.(yaml|yml)}"
((exit_status |= ${?}))

print_section '🌈 zizmor'
zizmor --offline -qq -- .github
((exit_status |= ${?}))

print_section '🐚 ShellCheck'
shellcheck -s bash -o all -e SC1009,SC1088,SC2296,SC2298,SC2299,SC2300,SC2301,SC2312 -a -P SCRIPTDIR --\
	"${script_files[@]}"
((exit_status |= ${?}))

print_section '🐭 EditorConfig'
editorconfig-checker -disable-max-line-length -- "${files[@]}" # Scripts/layout lints line lengths, counting tabs as 2
((exit_status |= ${?}))

print_section '🚷 Non-Executables'
# shellcheck disable=SC1036,SC2206
readonly -a non_executables=(${^script_files}(N^f+111))
if (("${#non_executables[@]}")); then
	print_error 'Not executable: %s' "${(j:, :)non_executables}"
	((exit_status |= 1))
fi

exit "${exit_status}"
