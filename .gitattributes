#
# .gitattributes
# swift-cascading-configuration
#

* text=auto eol=lf
# Do not remove potentially intentional trailing spaces in Markdown.
*.md text eol=lf whitespace=-blank-at-eol
*.swift text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.swift-version text eol=lf
.swiftformat text eol=lf
.xcode-version text eol=lf
