#
# .editorconfig
# swift-cascading-configuration
#
# EditorConfig 0.17.2
#

root = true

[*]
charset = utf-8
continuation_indent_size = 0
end_of_line = lf
indent_size = tab
indent_style = tab
insert_final_newline = true
max_line_length = 120
quote_type = single
spelling_language = en_US
tab_width = 2
trim_trailing_whitespace = true

[{*.swiftformat,allowed_signers}]
max_line_length = off

[*.md]
indent_size = 1
indent_style = space
max_line_length = 80
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2
indent_style = space

# Keeps each license text verbatim
[LICENSES/*]
indent_style = unset

# Keeps each vendored file verbatim
[{Sources,Tests}/*/Vendored/**]
indent_size = unset
indent_style = unset
insert_final_newline = unset
max_line_length = unset
tab_width = unset
trim_trailing_whitespace = unset
